<!-- StatCard.razor — Reusable metric card for dashboard -->
<div class="card border-0 shadow-sm h-100">
    <div class="card-body d-flex align-items-center gap-3">
        <div class="rounded-circle bg-@Color bg-opacity-10 text-@Color d-flex align-items-center justify-content-center"
             style="width:52px;height:52px;flex-shrink:0;">
            <i class="bi @Icon fs-4"></i>
        </div>
        <div>
            <div class="fs-3 fw-bold lh-1">@Value</div>
            <div class="text-muted small">@Label</div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Icon  { get; set; } = "bi-circle";
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string Color { get; set; } = "primary";
}
