@page "/admin/students/edit/{Id:guid}"
@using EduConnect.Services
@using EduConnect.Interfaces
@using EduConnect.Models
@using EduConnect.Enums
@using EduConnect.Components
@inject AuthStateService AuthService
@inject IStudentService StudentService
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Edit Student — EduConnect</PageTitle>

@if (!AuthService.IsInRole(UserRole.Admin)) { Nav.NavigateTo("/unauthorized"); return; }

<div class="d-flex align-items-center mb-4 gap-3">
    <a href="/admin/students" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>
    <h2 class="fw-bold mb-0"><i class="bi bi-pencil-fill me-2 text-warning"></i>Edit Student</h2>
</div>

<LoadingSpinner IsLoading="@_loading">
    @if (_student is null)
    {
        <AlertBox Message="Student not found." Type="AlertType.Error" />
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-12 col-lg-7">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <AlertBox Message="@_successMsg" Type="AlertType.Success" OnDismissed="@(() => _successMsg = string.Empty)" />
                        <AlertBox Message="@_errorMsg"   Type="AlertType.Error"   OnDismissed="@(() => _errorMsg = string.Empty)" />

                        <!-- One-way binding on load: pre-populates form from existing data -->
                        <!-- Two-way binding for edits: @bind keeps the local copy in sync -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Full Name</label>
                            <input type="text" class="form-control @ErrorClass("FullName")"
                                   @bind="_student.FullName" @bind:event="oninput" />
                            <ValidationMsg Field="FullName" Errors="_student.ValidationErrors" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email Address</label>
                            <input type="email" class="form-control @ErrorClass("Email")"
                                   @bind="_student.Email" @bind:event="oninput" />
                            <ValidationMsg Field="Email" Errors="_student.ValidationErrors" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Semester</label>
                                <select class="form-select" @bind="_student.Semester">
                                    @for (int i = 1; i <= 8; i++)
                                    {
                                        <option value="@i">Semester @i</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">CGPA</label>
                                <input type="number" class="form-control"
                                       min="0" max="4" step="0.01"
                                       @bind="_student.CGPA" />
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-3">
                            <button class="btn btn-warning px-4" @onclick="HandleSave" disabled="@_saving">
                                @if (_saving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                <i class="bi bi-save me-1"></i>Save Changes
                            </button>
                            <a href="/admin/students" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</LoadingSpinner>

@code {
    [Parameter] public Guid Id { get; set; }

    private Student? _student;
    private string _successMsg = string.Empty;
    private string _errorMsg   = string.Empty;
    private bool _loading = true;
    private bool _saving  = false;

    protected override void OnParametersSet()
    {
        // One-way binding on load: load existing student data into form
        var original = StudentService.GetById(Id);
        if (original is not null)
        {
            // Work on a copy so edits don't directly mutate the store until saved
            _student = new Student
            {
                Id       = original.Id,
                FullName = original.FullName,
                Email    = original.Email,
                Password = original.Password,
                Semester = original.Semester,
                CGPA     = original.CGPA
            };
            _student.Enrollments.AddRange(original.Enrollments);
        }
        _loading = false;
    }

    private async Task HandleSave()
    {
        if (_student is null) return;

        // Temporarily relax password check for edit (password may not be re-entered)
        if (string.IsNullOrWhiteSpace(_student.Password))
            _student.Password = "placeholder"; // won't be null for validation

        if (!_student.Validate())
        {
            _errorMsg = "Please fix the errors below.";
            return;
        }

        _saving = true;
        await Task.Delay(300);

        // On save, update in-memory repository and fire OnStudentUpdated event
        StudentService.Update(_student);
        _saving = false;
        _successMsg = "Student updated successfully!";
    }

    private string ErrorClass(string field) =>
        _student?.ValidationErrors.ContainsKey(field) == true ? "is-invalid" : string.Empty;
}
