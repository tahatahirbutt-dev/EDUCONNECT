@page "/admin/reports/grades"
@using EduConnect.Services
@using EduConnect.Interfaces
@using EduConnect.Enums
@using EduConnect.Components
@inject AuthStateService AuthService
@inject IStudentService StudentService
@inject IGradeService GradeService
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Grade Report — EduConnect</PageTitle>

@if (!AuthService.IsInRole(UserRole.Admin)) { Nav.NavigateTo("/unauthorized"); return; }

<div class="mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-bar-chart-fill me-2 text-warning"></i>Grade Report</h2>
    <p class="text-muted small">All students sorted by CGPA (highest first)</p>
</div>

<!-- Grade category summary cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <StatCard Icon="bi-trophy-fill" Label="A Grade (CGPA ≥ 3.5)" Value="@_aCount.ToString()" Color="success" />
    </div>
    <div class="col-sm-6 col-lg-3">
        <StatCard Icon="bi-star-fill" Label="B Grade (≥ 3.0)" Value="@_bCount.ToString()" Color="primary" />
    </div>
    <div class="col-sm-6 col-lg-3">
        <StatCard Icon="bi-dash-circle" Label="C Grade (≥ 2.0)" Value="@_cCount.ToString()" Color="warning" />
    </div>
    <div class="col-sm-6 col-lg-3">
        <StatCard Icon="bi-exclamation-triangle-fill" Label="Below 2.0" Value="@_dCount.ToString()" Color="danger" />
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Student</th>
                        <th>Email</th>
                        <th>Semester</th>
                        <th>Courses Graded</th>
                        <th>CGPA</th>
                        <th>Category</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rank = 1; }
                    @foreach (var row in _reportRows)
                    {
                        <tr>
                            <td class="text-muted">@rank++</td>
                            <td class="fw-semibold">
                                <a href="/admin/students/@row.StudentId" class="text-decoration-none">@row.Name</a>
                            </td>
                            <td class="text-muted small">@row.Email</td>
                            <td><span class="badge bg-secondary">Sem @row.Semester</span></td>
                            <td>@row.GradeCount</td>
                            <td><span class="badge fs-6 @CgpaBadge(row.CGPA)">@row.CGPA.ToString("F2")</span></td>
                            <td><span class="badge @CategoryBadge(row.CGPA)">@GetCategory(row.CGPA)</span></td>
                        </tr>
                    }
                    @if (!_reportRows.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No grade data available.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private record ReportRow(Guid StudentId, string Name, string Email, int Semester, int GradeCount, double CGPA);
    private List<ReportRow> _reportRows = new();
    private int _aCount, _bCount, _cCount, _dCount;

    protected override void OnInitialized()
    {
        // Build report: all students sorted descending by CGPA
        _reportRows = StudentService.GetAll()
            .Select(s => new ReportRow(
                s.Id, s.FullName, s.Email, s.Semester,
                GradeService.GetGradesForStudent(s.Id).Count(),
                GradeService.ComputeCGPA(s.Id)))
            .OrderByDescending(r => r.CGPA)
            .ToList();

        // Count students in each grade category
        _aCount = _reportRows.Count(r => r.CGPA >= 3.5);
        _bCount = _reportRows.Count(r => r.CGPA >= 3.0 && r.CGPA < 3.5);
        _cCount = _reportRows.Count(r => r.CGPA >= 2.0 && r.CGPA < 3.0);
        _dCount = _reportRows.Count(r => r.CGPA < 2.0);
    }

    private static string GetCategory(double cgpa) => cgpa switch
    {
        >= 3.5 => "Distinction",
        >= 3.0 => "Merit",
        >= 2.0 => "Pass",
        _ => "At Risk"
    };

    private static string CgpaBadge(double cgpa) => cgpa switch
    {
        >= 3.5 => "bg-success",
        >= 3.0 => "bg-primary",
        >= 2.0 => "bg-warning text-dark",
        _ => "bg-danger"
    };

    private static string CategoryBadge(double cgpa) => cgpa switch
    {
        >= 3.5 => "bg-success",
        >= 3.0 => "bg-primary",
        >= 2.0 => "bg-warning text-dark",
        _ => "bg-danger"
    };
}
