@page "/admin/students"
@using EduConnect.Services
@using EduConnect.Interfaces
@using EduConnect.Models
@using EduConnect.Enums
@using EduConnect.Components
@using EduConnect.Exceptions
@inject AuthStateService AuthService
@inject IStudentService StudentService
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Students — EduConnect Admin</PageTitle>

@if (!AuthService.IsInRole(UserRole.Admin)) { Nav.NavigateTo("/unauthorized"); return; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-people-fill me-2 text-primary"></i>Student Management</h2>
        <p class="text-muted small mb-0">Manage all registered students</p>
    </div>
    <a href="/admin/students/add" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Add Student
    </a>
</div>

<AlertBox Message="@_successMsg" Type="AlertType.Success" OnDismissed="@(() => _successMsg = string.Empty)" />
<AlertBox Message="@_errorMsg"   Type="AlertType.Error"   OnDismissed="@(() => _errorMsg = string.Empty)" />

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <!-- Two-way binding: search input updates _searchTerm; displayed list updates instantly (no button) -->
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control"
                   placeholder="Search by name or email..."
                   @bind="_searchTerm"
                   @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                <button class="btn btn-outline-secondary" @onclick="() => _searchTerm = string.Empty">
                    <i class="bi bi-x-lg"></i>
                </button>
            }
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Semester</th>
                        <th>CGPA</th>
                        <th>Enrollments</th>
                        <th style="width:160px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in FilteredStudents)
                    {
                        <tr>
                            <td class="fw-semibold">@student.FullName</td>
                            <td class="text-muted">@student.Email</td>
                            <td><span class="badge bg-secondary">Sem @student.Semester</span></td>
                            <td>
                                <span class="badge @CgpaBadge(student.CGPA)">@student.CGPA.ToString("F2")</span>
                            </td>
                            <td>@student.Enrollments.Count(e => e.Status == CourseEnrollmentActiveStatus.Active) active</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a href="/admin/students/@student.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="/admin/students/edit/@student.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => PromptDelete(student)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!FilteredStudents.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                No students match "@_searchTerm"
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Bootstrap confirmation modal before deletion -->
<ConfirmDialog Title="Delete Student"
               Message="@($"Are you sure you want to delete {_studentToDelete?.FullName}? This cannot be undone.")"
               IsVisible="_showConfirm"
               OnConfirmed="ConfirmDelete"
               OnCancelled="() => _showConfirm = false" />

@code {
    // Two-way binding variable — list filters as user types, no button click needed
    private string _searchTerm = string.Empty;
    private string _successMsg = string.Empty;
    private string _errorMsg   = string.Empty;
    private bool   _showConfirm = false;
    private Student? _studentToDelete;

    // Computed property: filtered list depends on _searchTerm
    // Because @bind="oninput" triggers re-render, this property re-evaluates automatically
    private IEnumerable<Student> FilteredStudents =>
        StudentService.SearchStudents(_searchTerm);

    private void PromptDelete(Student student)
    {
        _studentToDelete = student;
        _showConfirm = true;
    }

    private void ConfirmDelete()
    {
        _showConfirm = false;
        if (_studentToDelete is null) return;
        try
        {
            StudentService.Delete(_studentToDelete.Id);
            _successMsg = $"Student '{_studentToDelete.FullName}' deleted successfully.";
            _studentToDelete = null;
        }
        catch (StudentHasActiveEnrollmentsException ex)
        {
            // Custom exception caught here — student is NOT deleted
            _errorMsg = ex.Message;
        }
    }

    private static string CgpaBadge(double cgpa) => cgpa switch
    {
        >= 3.5 => "bg-success",
        >= 2.5 => "bg-primary",
        >= 1.5 => "bg-warning text-dark",
        _ => "bg-danger"
    };
}
